{
  "mcpServers": {
    "codex": {
      "type": "stdio",
      "command": "codex",
      "args": ["mcp-server", "-c", "sandbox_mode=read-only", "-c", "approval_policy=never"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "oak-local-dev": {
      "type": "http",
      "url": "http://localhost:3333/mcp"
    },
    "oak-preview": {
      "type": "http",
      "url": "https://poc-oak-open-curriculum-mcp-git-docs-planning-and-validation.vercel.thenational.academy/mcp"
    },
    "mcpjam": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["exec", "mcpjam", "mcp"],
      "env": {}
    },
    "oak-prod": {
      "type": "http",
      "url": "https://mcp.thenational.academy/mcp"
    },
    "claude-design": {
      "type": "http",
      "url": "https://api.anthropic.com/v1/design/mcp"
    }
  }
}
