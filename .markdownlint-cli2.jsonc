// markdownlint-cli2 configuration — scope/ignore doctrine for the Markdown gate.
//
// Rules live in `.markdownlint.json` (auto-read by cli2 as the `config` object);
// this file owns ONLY the lint footprint (`globs` + `ignores`). Keep this file's
// `ignores` in lock-step with the gate doctrine in
// `.agent/rules/no-warning-toleration.md` §Scope discipline: canon surfaces lint
// by default; reference / synthesis / archive / generated material is excluded.
// Moving a folder in or out of this list is a deliberate governance act.
//
// Footprint model: cli2's `**/*.md` DOES traverse dot-directories (verified —
// it lints `.cursor/`, `.claude/`, etc. without a `--dot` flag). So non-canon
// dot-dirs must be excluded EXPLICITLY in `ignores`, exactly as the old
// `.markdownlintignore` did. The `.agent/**/*.md` glob is retained for clarity
// even though `**/*.md` already covers it.
//
// HARD RULE: never add an `ignores` entry beginning with `!` or `#`. In cli2
// v0.22.x such an entry silently zeroes the entire run to "0 error(s)" (a
// false-green gate), not a re-include. Express exclusions positively only.
{
  "globs": ["**/*.md", ".agent/**/*.md"],
  "ignores": [
    ".agent/analysis/**",
    ".agent/archive/**",
    ".agent/evaluations/**",
    ".agent/experience/**",
    ".agent/hooks/**",
    ".agent/milestones/**",
    ".agent/proposals/**",
    ".agent/prompts/**",
    ".agent/reference/**",
    ".agent/reference-local/**",
    ".agent/reports/**",
    ".agent/research/**",
    ".agent/roles/**",
    ".cursor/**",
    ".claude/**",
    ".agents/**",
    "tmp/**",
    "**/CHANGELOG.md",
    "**/archive/**",
    "**/reference/**",
    "**/research/**",
    "**/temp-secrets/**",
    "node_modules/**",
    "**/node_modules/**",
    "packages/sdks/oak-curriculum-sdk/docs/api/**",
    // Design-system held-out studio material (ADR-213; workspace .gitignore
    // classes 15-16): gitignored when re-obtained locally, but this tool does
    // not read .gitignore — exclude explicitly so a local studio re-obtain
    // cannot fail the root markdown gate. The import staging dir likewise.
    "packages/design/oak-design-system/uploads/**",
    "packages/design/oak-design-system/CLAUDE.md",
    "packages/design/oak-design-system/SKILL.md",
    "packages/design/oak-design-system/HANDOFF.md",
    "packages/design/oak-design-system/CLAUDE-CODE-HANDOFF.md",
    "packages/design/design-import/**",
    // MCP-137 preservation tier: byte-preserved capture folders (pure copies
    // from their sources — see studio-source/PRESERVATION-README.md); their
    // markdown is captured content, never repo documentation. The adjacent
    // PRESERVATION-README.md itself is authored and stays in lint scope.
    "packages/design/oak-design-system/studio-source/original-capture-2026-07-23/**",
    "packages/design/oak-design-system/studio-source/iteration-pull-preservation-2026-07-23/**",
    ".agent/state/collaboration/shared-comms-log.md",
    ".agent/state/collaboration/cross-worktree-work-state.md",
    ".agent/collaboration/rapid-comms/2026-*.md",
    ".agent/collaboration/rapid-comms/.starless-notice-body.md",
    "**/test-results/**",
    "**/test-artifacts/**",
    ".stryker-tmp/**",
  ],
  // Lint scope = tracked repo files: gitignored content (untracked vendor
  // reference data, local state) is not repo documentation (owner-ratified
  // 2026-07-02).
  "gitignore": true,
}
