# =============================================================================
# Oak Curriculum MCP Streamable HTTP Server — Environment Variables
# =============================================================================
# Copy to .env.local and fill in your values.
# Loading order (highest precedence last):
#   repo root .env < repo root .env.local < this dir .env < this dir .env.local < process.env
# See: src/runtime-config.ts, ADR-116

# =============================================================================
# Oak Curriculum API
# =============================================================================
OAK_API_KEY=your_oak_api_key_here

# =============================================================================
# Clerk Authentication
# =============================================================================
# Required unless DANGEROUSLY_DISABLE_AUTH=true.
# Get these from: https://dashboard.clerk.com/
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Completely disables auth (local development only, never in production)
# DANGEROUSLY_DISABLE_AUTH=true

# =============================================================================
# Elasticsearch
# =============================================================================
# Required for search features and some MCP tool modes.
ELASTICSEARCH_URL=https://your-elasticsearch-url-here
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key_here

# =============================================================================
# Sentry + OpenTelemetry Observability
# =============================================================================
# Three modes:
#   off     — no Sentry (default, safe for local dev)
#   fixture — in-memory capture for tests, no network calls
#   sentry  — live error capture + tracing (requires DSN + sample rate)
SENTRY_MODE=off

# Required when SENTRY_MODE=sentry:
# SENTRY_DSN=https://public@your-org.ingest.sentry.io/http-project-id
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Optional overrides only:
# SENTRY_ENVIRONMENT_OVERRIDE=production
# SENTRY_RELEASE_OVERRIDE=your-release-identifier
# APP_VERSION_OVERRIDE=1.5.0
# GIT_SHA_OVERRIDE=3ad6f452abc123def4567890abc123def4567890
#
# Default metadata behaviour:
# - environment: SENTRY_ENVIRONMENT_OVERRIDE -> VERCEL_ENV -> development
# - release: SENTRY_RELEASE_OVERRIDE -> root package.json version
# - git SHA metadata: GIT_SHA_OVERRIDE -> VERCEL_GIT_COMMIT_SHA
#
# The root package.json version is the canonical application version and is
# updated by the GitHub release workflow, not on every main commit.
#
# Optional Sentry SDK flags:
# SENTRY_ENABLE_LOGS=true
# SENTRY_DEBUG=false

# Sentry CLI token
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# =============================================================================
# PostHog Product Analytics (MCP-63 family)
# =============================================================================
# OFF by default. Activates only when "posthog" is listed in
# OBSERVABILITY_SINKS — a JSON array string, e.g. '["sentry","posthog"]'.
# When posthog is NOT selected, every POSTHOG_* value below is ignored and
# local development needs nothing here. When it IS selected, ALL FOUR values
# below are required and strictly validated at startup; any invalid value
# stops startup rather than silently degrading. Selecting "posthog"
# requires Sentry to be actively delivering AND logging in EVERY
# environment — development, preview, and production alike: "sentry" in
# OBSERVABILITY_SINKS, SENTRY_MODE=sentry (not the default "off"),
# SENTRY_DSN and SENTRY_TRACES_SAMPLE_RATE set (live Sentry parses the rate
# at boot), and SENTRY_ENABLE_LOGS not "false" (it turns the log sink off)
# (owner ruling 2026-07-29, strengthened 2026-08-04: Sentry-as-a-sink is
# non-negotiable; MCP-361). Selecting posthog with
# DANGEROUSLY_DISABLE_AUTH=true is refused.
#
# Listing "sentry" only marks the sink selected — SENTRY_MODE gates real
# delivery, so SENTRY_MODE=off would boot the sink dark (a false marker),
# and SENTRY_ENABLE_LOGS=false would silence the log sink. Startup therefore
# REQUIRES SENTRY_MODE=sentry with its DSN, traces sample rate, and logs
# left enabled (Sentry section above) whenever posthog is selected; a false
# or dark marker is rejected, not tolerated.
# OBSERVABILITY_SINKS=["sentry","posthog"]

# SECRETS — validated and reserved at startup; stripped from the
# handler-facing runtime config; never logged or serialised. Never commit
# real values.
#
# Project ingestion key from the approved EU PostHog project
# (Project Settings -> Project API key; phc_-class, write-only by design):
# POSTHOG_PROJECT_API_KEY=phc_your_project_key_here
#
# Pseudonym keyring: JSON array of { "id", "key" } records. Each id matches
# ^[a-z0-9][a-z0-9_-]{0,31}$; each key is a 43-char unpadded base64url
# encoding of exactly 32 bytes; ids AND key material must both be unique
# across the ring. Generate a key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotation adds an entry and switches the active id atomically; retired keys
# stay in the ring until the retention/deletion path clears them. Losing a
# retired key breaks the erasure derivation for its era — keep durable
# custody outside the deployment platform.
# POSTHOG_PSEUDONYM_KEYRING=[{"id":"k2026_01","key":"<43-char-base64url>"}]

# Non-secret values (validated at startup; stripped from the handler-facing
# runtime config):
#
# Names the keyring entry used for new actor projections. The id is embedded
# in every emitted distinct_id, so it carries no secret material.
# POSTHOG_PSEUDONYM_ACTIVE_KEY_ID=k2026_01
#
# Must be exactly this EU host — no other region is accepted (the vendor SDK
# default is the US host, so this override is load-bearing):
# POSTHOG_HOST=https://eu.i.posthog.com

# POSTHOG_CAPTURE_MODE is NOT a supported input: any non-empty value fails
# startup when posthog is selected, so ambient configuration cannot silently
# change the reviewed transport. Do not set it.

# =============================================================================
# Server
# =============================================================================
# PORT=3333
LOG_LEVEL=info

# DNS rebinding protection — auto-includes localhost.
# On Vercel, deployment URLs are added automatically.
# ALLOWED_HOSTS=localhost,127.0.0.1

# The address this server is served AT, when an edge presents a different
# Host to the origin (MCP-172: Cloudflare serves www.thenational.academy/mcp
# with the Host overridden). Set it and every self-description surface — OAuth
# protected-resource and authorization-server metadata, the RFC 8707 resource
# URL, the WWW-Authenticate challenge — names https://<value>. Bare hostname
# only: no scheme, port, path, or loopback name (startup-validated).
# CANONICAL_HOST=www.thenational.academy

# MCP transport mode: stateless (default, recommended for Vercel) or session
# REMOTE_MCP_MODE=stateless

# Shared secret that gates the diagnostic `/test-error` route.
# When set in `preview` or `development` environments, registers
# `POST /test-error` for repeatable Sentry capture validation
# (handled / unhandled / rejected modes). Forbidden in production — a hard
# startup failure. Provision a RANDOM (high-entropy) value — the schema enforces
# only the 16-char length floor, which is not itself entropy.
TEST_ERROR_SECRET=your-test-error-secret-here
