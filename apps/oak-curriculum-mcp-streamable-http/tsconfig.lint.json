{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "build-scripts/**/*.ts",
    "build-scripts/**/*.d.mts",
    "operations/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "e2e-tests/**/*.ts",
    "**/*.test.ts",
    // Scoped to src/, deliberately: a bare `**/*.test.tsx` reaches into
    // widget/, whose tests are .tsx and whose DOM lib is declared in its own
    // project — pulling them in here type-checks them without lib.dom.
    "src/**/*.test.tsx",
    "*.config.ts",
    "vitest.global-setup.ts",
    "vitest.e2e.config.ts"
  ],
  "exclude": ["node_modules", "dist", "temp-secrets", "../../.agent/reference/**"]
}
