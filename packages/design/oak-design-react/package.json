{
  "name": "@oaknational/oak-design-react",
  "version": "0.0.0-development",
  "private": true,
  "description": "React binding tier for the Oak Open Curriculum Design System (ADR-213 §3): framework-covariant adapters over the kit's framework-neutral surface. First resident: the useSyncExternalStore theme-store adapter (non-visual; no React dependency until the first component export arms the ADR-147 gate).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist .turbo",
    "build": "tsup && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "type-check": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@oaknational/eslint-plugin-standards": "workspace:*",
    "@oaknational/workspace-config": "workspace:*",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
