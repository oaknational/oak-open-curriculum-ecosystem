    "ground": {
      "$value": "{oak.color.grey60}",
      "$type": "color"
    },
    "neutral": {
      "$value": "0.25rem 0.25rem 0 {shadow.ground}"
    },
    "neutral-ring": {
      "$value": "0 0 0 0.3rem {shadow.ground}"
    },
    "ink": {
      "$value": "0.063rem 0.125rem 0 {oak.color.black-true}"
    },
