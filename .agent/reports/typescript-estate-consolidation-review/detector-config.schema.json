{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detector-config.schema.json",
  "title": "TypeScript estate detector configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractRevision", "reviewId", "calibrationBaseCommit", "frozenAt", "refreezeReason", "sourceExtensions", "implementationGate", "snapshot", "moduleResolution", "detectors", "generatedOutputRules", "generatedOutputRuleSemantics", "vocabularies", "provenanceClassification", "roleRules", "roleSemantics", "sourcePredicateDefinitions", "deliveryClassification", "constructs", "repetition", "typeTruthSignals", "graphObservation", "archetypeChains", "placementConformance", "proofEnvironmentPolicy", "generationProof", "packedSdkConsumerProof", "schemaShapeFingerprint", "testAndProofPlacement", "resourceLimits", "outputWrite", "ordering", "semanticValidation", "implementationIdentity", "serialisation", "heldOutAudit"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "contractRevision": { "const": "2.6" },
    "reviewId": { "const": "typescript-estate-consolidation-review" },
    "calibrationBaseCommit": { "$ref": "#/$defs/gitObjectId" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "refreezeReason": { "$ref": "#/$defs/nonEmptyString" },
    "sourceExtensions": {
      "const": [".ts", ".tsx"]
    },
    "implementationGate": { "$ref": "#/$defs/implementationGate" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "moduleResolution": { "$ref": "#/$defs/moduleResolution" },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/detector" }
    },
    "generatedOutputRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/generatedOutputRule" }
    },
    "generatedOutputRuleSemantics": { "$ref": "#/$defs/generatedOutputRuleSemantics" },
    "vocabularies": { "$ref": "#/$defs/vocabularies" },
    "provenanceClassification": { "$ref": "#/$defs/provenanceClassification" },
    "roleRules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/roleRule" }
    },
    "roleSemantics": { "$ref": "#/$defs/roleSemantics" },
    "sourcePredicateDefinitions": { "$ref": "#/$defs/sourcePredicateDefinitions" },
    "deliveryClassification": { "$ref": "#/$defs/deliveryClassification" },
    "constructs": { "$ref": "#/$defs/constructs" },
    "repetition": { "$ref": "#/$defs/repetition" },
    "typeTruthSignals": { "$ref": "#/$defs/typeTruthSignals" },
    "graphObservation": { "$ref": "#/$defs/graphObservation" },
    "archetypeChains": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/archetypeChain" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "id": { "const": "openapi-curriculum-sdk-mcp" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "bulk-vocabulary-search-consumer" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "agent-tools-dist-cli-hook" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "tsx-bundle-served-ui" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "placementConformance": { "$ref": "#/$defs/placementConformance" },
    "proofEnvironmentPolicy": { "$ref": "#/$defs/proofEnvironmentPolicy" },
    "generationProof": { "$ref": "#/$defs/generationProof" },
    "packedSdkConsumerProof": { "$ref": "#/$defs/packedSdkConsumerProof" },
    "schemaShapeFingerprint": { "$ref": "#/$defs/schemaShapeFingerprint" },
    "testAndProofPlacement": { "$ref": "#/$defs/testAndProofPlacement" },
    "resourceLimits": { "$ref": "#/$defs/resourceLimits" },
    "outputWrite": { "$ref": "#/$defs/outputWrite" },
    "ordering": { "$ref": "#/$defs/ordering" },
    "semanticValidation": { "$ref": "#/$defs/semanticValidation" },
    "implementationIdentity": { "$ref": "#/$defs/implementationIdentity" },
    "serialisation": { "$ref": "#/$defs/serialisation" },
    "heldOutAudit": { "$ref": "#/$defs/heldOutAudit" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "implementationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estateRun", "contractReadySlices", "contractHeldSlices", "releaseRule"],
      "properties": {
        "estateRun": {
          "const": "prohibited-until-contract-held-slices-empty-and-built-smoke-passes"
        },
        "contractReadySlices": {
          "const": [
            "git-pinned-source-snapshot",
            "pinned-auxiliary-blob-access",
            "canonical-output-foundations",
            "construct-counting",
            "type-truth-counting",
            "schema-shape-observation",
            "region-repetition",
            "workspace-attribution",
            "provenance-classification",
            "role-classification"
          ]
        },
        "contractHeldSlices": {
          "const": [
            "module-declaration-extraction",
            "module-resolution",
            "delivery-classification",
            "graph-and-ownership-assembly",
            "candidate-synthesis"
          ]
        },
        "releaseRule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "defaultRef", "commitResolution", "treeResolution", "pathEnumeration", "contentRead", "auxiliaryContentRead", "auxiliaryReadLedger", "gitExecutable", "gitEnvironment", "repositoryAnchoring", "replacementObjects", "filesystemSourceReads", "missingObjectBehaviour"],
      "properties": {
        "source": { "const": "git-tree" },
        "defaultRef": { "const": "HEAD" },
        "commitResolution": { "$ref": "#/$defs/nonEmptyString" },
        "treeResolution": { "$ref": "#/$defs/nonEmptyString" },
        "pathEnumeration": { "$ref": "#/$defs/nonEmptyString" },
        "contentRead": { "$ref": "#/$defs/nonEmptyString" },
        "auxiliaryContentRead": { "$ref": "#/$defs/nonEmptyString" },
        "auxiliaryReadLedger": { "$ref": "#/$defs/nonEmptyString" },
        "gitExecutable": { "$ref": "#/$defs/nonEmptyString" },
        "gitEnvironment": { "$ref": "#/$defs/nonEmptyString" },
        "repositoryAnchoring": { "$ref": "#/$defs/nonEmptyString" },
        "replacementObjects": { "const": false },
        "filesystemSourceReads": { "const": false },
        "missingObjectBehaviour": { "const": "fail-complete-run" }
      }
    },
    "moduleResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declarationAndResolutionAreSeparate", "typecheckProjectSelection", "emittingProjectSelection", "relativeAndPathAliasResolver", "nodeBuiltinResolver", "workspaceAttribution", "workspacePackageResolver", "externalPackageResolver", "nonLiteralResolver", "resolvedFileContainment", "resolverVersion"],
      "properties": {
        "declarationAndResolutionAreSeparate": { "const": true },
        "typecheckProjectSelection": { "$ref": "#/$defs/nonEmptyString" },
        "emittingProjectSelection": { "$ref": "#/$defs/nonEmptyString" },
        "relativeAndPathAliasResolver": { "$ref": "#/$defs/nonEmptyString" },
        "nodeBuiltinResolver": { "$ref": "#/$defs/nonEmptyString" },
        "workspaceAttribution": { "$ref": "#/$defs/workspaceAttribution" },
        "workspacePackageResolver": { "$ref": "#/$defs/nonEmptyString" },
        "externalPackageResolver": { "$ref": "#/$defs/nonEmptyString" },
        "nonLiteralResolver": { "$ref": "#/$defs/nonEmptyString" },
        "resolvedFileContainment": { "$ref": "#/$defs/nonEmptyString" },
        "resolverVersion": { "const": "typescript-6.0.3" }
      }
    },
    "workspaceAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "manifestTreeRequirement", "utf8Decoding", "yamlParser", "documentRule", "rootRule", "packagesRule", "patternGrammar", "candidateManifestRule", "packageJsonRule", "packageNamePattern", "packageNameRule", "attributionRule", "dependencyRule"],
      "properties": {
        "manifestPath": { "const": "pnpm-workspace.yaml" },
        "manifestTreeRequirement": { "$ref": "#/$defs/nonEmptyString" },
        "utf8Decoding": { "$ref": "#/$defs/nonEmptyString" },
        "yamlParser": { "$ref": "#/$defs/workspaceYamlParser" },
        "documentRule": { "$ref": "#/$defs/nonEmptyString" },
        "rootRule": { "$ref": "#/$defs/nonEmptyString" },
        "packagesRule": { "$ref": "#/$defs/nonEmptyString" },
        "patternGrammar": { "$ref": "#/$defs/nonEmptyString" },
        "candidateManifestRule": { "$ref": "#/$defs/nonEmptyString" },
        "packageJsonRule": { "$ref": "#/$defs/nonEmptyString" },
        "packageNamePattern": { "const": "^(?:[A-Za-z0-9_~-][A-Za-z0-9._~-]*|@[A-Za-z0-9_~-][A-Za-z0-9._~-]*/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)$" },
        "packageNameRule": { "$ref": "#/$defs/nonEmptyString" },
        "attributionRule": { "$ref": "#/$defs/nonEmptyString" },
        "dependencyRule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "workspaceYamlParser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "entrypoint", "options"],
      "properties": {
        "package": { "const": "yaml" },
        "version": { "const": "2.9.0" },
        "entrypoint": { "const": "parseAllDocuments" },
        "options": { "$ref": "#/$defs/workspaceYamlParserOptions" }
      }
    },
    "workspaceYamlParserOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "schema", "strict", "uniqueKeys", "stringKeys", "merge", "resolveKnownTags", "customTags", "intAsBigInt", "prettyErrors", "logLevel"],
      "properties": {
        "version": { "const": "1.2" },
        "schema": { "const": "core" },
        "strict": { "const": true },
        "uniqueKeys": { "const": true },
        "stringKeys": { "const": false },
        "merge": { "const": false },
        "resolveKnownTags": { "const": false },
        "customTags": { "const": [] },
        "intAsBigInt": { "const": false },
        "prettyErrors": { "const": false },
        "logLevel": { "const": "silent" }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "purpose", "countingUnit", "calibrationStatus", "falsifier", "unresolvedBehaviour"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "purpose": { "$ref": "#/$defs/nonEmptyString" },
        "countingUnit": { "$ref": "#/$defs/nonEmptyString" },
        "calibrationStatus": { "enum": ["admitted", "admitted-pending-held-out", "rejected"] },
        "falsifier": { "$ref": "#/$defs/nonEmptyString" },
        "unresolvedBehaviour": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "generatedOutputRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pathPrefix", "producerEvidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "pathPrefix": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000\\\\]).+/$"
        },
        "producerEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "generatedOutputRuleSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleIdentity", "prefixForm", "prefixSeparation", "producerEvidence", "failureBehaviour"],
      "properties": {
        "ruleIdentity": { "$ref": "#/$defs/nonEmptyString" },
        "prefixForm": { "$ref": "#/$defs/nonEmptyString" },
        "prefixSeparation": { "$ref": "#/$defs/nonEmptyString" },
        "producerEvidence": { "$ref": "#/$defs/nonEmptyString" },
        "failureBehaviour": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "provenance", "deliveryDimensions", "deliveryStates"],
      "properties": {
        "roles": { "const": ["test-spec-support-fixture", "generator", "generated-contract-data-carrier", "build-time-producer", "cli-hook-operator", "tsx-syntax-source", "api-facade", "config-setup", "declaration", "research-evidence-template", "implementation-source", "unknown"] },
        "provenance": { "const": ["authored", "generated-confirmed", "generated-declared-unconfirmed", "imported", "unknown"] },
        "deliveryDimensions": { "const": ["typecheckProjectIncluded", "emittingProjectIncluded", "buildEmitted", "packageExported", "executableEntry", "runtimeRegistered", "operatorInvoked", "filesystemOrStringLoaded", "verificationOnly", "repositoryReferenceOnly"] },
        "deliveryStates": { "const": ["present", "absent", "not-probed", "ambiguous"] }
      }
    },
    "provenanceClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedPathMatchers", "generatedHeaderMatchers", "importedReferencePathRules", "pathMatcherSemantics", "signalCollection", "signalDeduplication", "signalOrdering", "generatedConfirmed", "generatedDeclaredUnconfirmed", "imported", "authored", "unknown", "precedence"],
      "properties": {
        "generatedPathMatchers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "values"],
              "properties": {
                "id": { "const": "generated-directory-segment" },
                "kind": { "const": "complete-path-segment" },
                "values": { "const": ["generated", "__generated__"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "values"],
              "properties": {
                "id": { "const": "generated-ts-basename-suffix" },
                "kind": { "const": "basename-suffix" },
                "values": { "const": [".generated.ts", ".generated.tsx"] }
              }
            }
          ],
          "items": false
        },
        "generatedHeaderMatchers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/generatedHeaderMatcher" }],
          "items": false
        },
        "importedReferencePathRules": { "const": [] },
        "pathMatcherSemantics": { "$ref": "#/$defs/nonEmptyString" },
        "signalCollection": { "$ref": "#/$defs/nonEmptyString" },
        "signalDeduplication": { "$ref": "#/$defs/nonEmptyString" },
        "signalOrdering": { "$ref": "#/$defs/nonEmptyString" },
        "generatedConfirmed": { "$ref": "#/$defs/nonEmptyString" },
        "generatedDeclaredUnconfirmed": { "$ref": "#/$defs/nonEmptyString" },
        "imported": { "$ref": "#/$defs/nonEmptyString" },
        "authored": { "$ref": "#/$defs/nonEmptyString" },
        "unknown": { "$ref": "#/$defs/nonEmptyString" },
        "precedence": { "const": ["generated-confirmed", "generated-declared-unconfirmed", "imported", "authored", "unknown"] }
      }
    },
    "generatedHeaderMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "flags", "commentRangeSelection", "matchSelection", "offsetRule"],
      "properties": {
        "id": { "const": "leading-generated-banner" },
        "source": { "const": "(?:auto[- ]?generated|generated file|do not edit)" },
        "flags": { "const": "iu" },
        "commentRangeSelection": { "$ref": "#/$defs/nonEmptyString" },
        "matchSelection": { "$ref": "#/$defs/nonEmptyString" },
        "offsetRule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "roleRule": {
      "oneOf": [
        { "$ref": "#/$defs/roleSelectorRule" },
        { "$ref": "#/$defs/roleFallbackRule" }
      ]
    },
    "roleSelectorRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "match"],
      "properties": {
        "role": { "enum": ["test-spec-support-fixture", "generator", "generated-contract-data-carrier", "build-time-producer", "cli-hook-operator", "tsx-syntax-source", "api-facade", "config-setup", "declaration", "research-evidence-template"] },
        "match": { "const": "all" },
        "pathRegexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "provenanceValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["generated-confirmed", "generated-declared-unconfirmed"] }
        },
        "sourcePredicates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["contains-export-declaration"] } }
      },
      "anyOf": [
        { "properties": { "pathRegexes": {} }, "required": ["pathRegexes"] },
        { "properties": { "provenanceValues": {} }, "required": ["provenanceValues"] },
        { "properties": { "sourcePredicates": {} }, "required": ["sourcePredicates"] }
      ]
    },
    "roleFallbackRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "match", "fallback"],
          "properties": {
            "role": { "const": "implementation-source" },
            "match": { "const": "all" },
            "fallback": { "const": "readable-with-no-other-role" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "match", "fallback"],
          "properties": {
            "role": { "const": "unknown" },
            "match": { "const": "all" },
            "fallback": { "const": "unreadable-invalid-utf8-or-unsupported-mode" }
          }
        }
      ]
    },
    "roleSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathRegexCompilation", "ruleUniqueness", "withinFamily", "acrossPopulatedFamilies", "selectorEvaluation", "sourcePredicateAvailability", "fallbackEvaluation", "roleOutput", "semanticBoundary"],
      "properties": {
        "pathRegexCompilation": { "$ref": "#/$defs/nonEmptyString" },
        "ruleUniqueness": { "$ref": "#/$defs/nonEmptyString" },
        "withinFamily": { "const": "or" },
        "acrossPopulatedFamilies": { "const": "and" },
        "selectorEvaluation": { "$ref": "#/$defs/nonEmptyString" },
        "sourcePredicateAvailability": { "$ref": "#/$defs/nonEmptyString" },
        "fallbackEvaluation": { "$ref": "#/$defs/nonEmptyString" },
        "roleOutput": { "$ref": "#/$defs/nonEmptyString" },
        "semanticBoundary": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "sourcePredicateDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains-export-declaration"],
      "properties": {
        "contains-export-declaration": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "deliveryClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateVocabulary", "typecheckProjectIncluded", "emittingProjectIncluded", "buildEmitted", "packageExported", "executableEntry", "runtimeRegistered", "operatorInvoked", "filesystemOrStringLoaded", "verificationOnly", "repositoryReferenceOnly", "absenceRule"],
      "properties": {
        "stateVocabulary": { "const": ["present", "absent", "not-probed", "ambiguous"] },
        "typecheckProjectIncluded": { "$ref": "#/$defs/nonEmptyString" },
        "emittingProjectIncluded": { "$ref": "#/$defs/nonEmptyString" },
        "buildEmitted": { "$ref": "#/$defs/nonEmptyString" },
        "packageExported": { "$ref": "#/$defs/nonEmptyString" },
        "executableEntry": { "$ref": "#/$defs/nonEmptyString" },
        "runtimeRegistered": { "$ref": "#/$defs/nonEmptyString" },
        "operatorInvoked": { "$ref": "#/$defs/nonEmptyString" },
        "filesystemOrStringLoaded": { "$ref": "#/$defs/nonEmptyString" },
        "verificationOnly": { "$ref": "#/$defs/nonEmptyString" },
        "repositoryReferenceOnly": { "$ref": "#/$defs/nonEmptyString" },
        "absenceRule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "dataStructureDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "astKinds", "namedReferences"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "astKinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "namedReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "algorithmDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "astKinds", "callNames"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "astKinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "callNames": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "constructs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeValueStructures", "typeModelStructures", "algorithms", "namedReferenceMatch", "callNameMatch", "astKindCount", "rankingBoundary", "algorithmBoundary"],
      "properties": {
        "runtimeValueStructures": {
          "type": "array",
          "minItems": 11,
          "items": { "$ref": "#/$defs/dataStructureDefinition" }
        },
        "typeModelStructures": { "type": "array", "minItems": 11, "items": { "$ref": "#/$defs/dataStructureDefinition" } },
        "algorithms": {
          "type": "array",
          "minItems": 11,
          "items": { "$ref": "#/$defs/algorithmDefinition" }
        },
        "namedReferenceMatch": { "$ref": "#/$defs/nonEmptyString" },
        "callNameMatch": { "$ref": "#/$defs/nonEmptyString" },
        "astKindCount": { "$ref": "#/$defs/nonEmptyString" },
        "rankingBoundary": { "$ref": "#/$defs/nonEmptyString" },
        "algorithmBoundary": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "repetition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumAstNodes", "minimumTokens", "minimumFiles", "eligibility", "regionAstKinds", "candidateEligibility", "nodeCount", "tokenCount", "exactEncodingVersion", "exactNormalisation", "exactFingerprint", "structuralEncodingVersion", "structuralNormalisation", "structuralFingerprint", "memberIdentity", "groupOrdering"],
      "properties": {
        "minimumAstNodes": { "type": "integer", "minimum": 1 },
        "minimumTokens": { "type": "integer", "minimum": 1 },
        "minimumFiles": { "type": "integer", "minimum": 2 },
        "eligibility": { "$ref": "#/$defs/nonEmptyString" },
        "regionAstKinds": {
          "const": ["FunctionDeclaration", "FunctionExpression", "ArrowFunction", "MethodDeclaration", "GetAccessor", "SetAccessor", "Constructor", "ClassDeclaration", "InterfaceDeclaration", "TypeAliasDeclaration", "TypeLiteral", "ObjectLiteralExpression"]
        },
        "candidateEligibility": { "$ref": "#/$defs/nonEmptyString" },
        "nodeCount": { "$ref": "#/$defs/nonEmptyString" },
        "tokenCount": { "$ref": "#/$defs/nonEmptyString" },
        "exactEncodingVersion": { "const": "typescript-printer-trivia-free-v1" },
        "exactNormalisation": { "$ref": "#/$defs/nonEmptyString" },
        "exactFingerprint": { "$ref": "#/$defs/nonEmptyString" },
        "structuralEncodingVersion": { "const": "typescript-getchildren-kinds-v1" },
        "structuralNormalisation": { "$ref": "#/$defs/nonEmptyString" },
        "structuralFingerprint": { "$ref": "#/$defs/nonEmptyString" },
        "memberIdentity": { "$ref": "#/$defs/nonEmptyString" },
        "groupOrdering": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "typeTruthSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeAssertion", "anyKeyword", "unknownKeyword", "nonNullAssertion", "typescriptSuppression", "recordStringUnknown", "zodUnknown", "interpretation"],
      "properties": {
