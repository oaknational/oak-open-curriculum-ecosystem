#!/usr/bin/env sh

# Refuse mailbox applies (git am) on a default branch BEFORE the patch is applied —
# applypatch-msg is the first git-am hook and fires while the tree is still
# untouched, so the guard that runs is always the committed one (a mailbox
# patch cannot edit its own guard first; pre-applypatch would run AFTER
# application and lose that property). Mechanics live in the shared guard
# (never-commit-to-main rule).
GUARD_BRANCH=""
GUARD_HINT="Abort this apply (git am --abort), then re-run it on a branch (git switch -c <branch>)."
. .husky/refuse-commit-on-main.sh
