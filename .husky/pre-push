#!/usr/bin/env sh

# Disable turbo TUI
export TURBO_UI=0


echo "🚀 Running pre-push checks..."

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ gitleaks is not installed."
  echo "Install it before running pre-push:"
  echo "  - macOS: brew install gitleaks"
  # gitleaks' go.mod declares the zricethezav module path; the
  # github.com/gitleaks/gitleaks form makes `go install` refuse the mismatch.
  echo "  - Go: go install github.com/zricethezav/gitleaks/v8@latest"
  echo "Then retry your push."
  exit 1
fi

echo "🛡️ Running secret scan (pushed commits only; CI scans full history)..."
# git feeds pre-push the destination remote name as $1 and, on stdin, one
# "<local_ref> <local_sha> <remote_ref> <remote_sha>" line per pushed ref. The
# tested range logic lives in agent-tools/src/secret-scan/; here we only capture
# git's ref lines into a temp file (a clean single-token path survives pnpm's
# argument handling) and hand them to the scanner, which scans ONLY the pushed
# commits. The CI secret-scan job runs the full `--branches --tags` scan as the
# comprehensive backstop, so no history goes unscanned.
secret_scan_refs="$(mktemp)"
[ -t 0 ] || cat > "$secret_scan_refs"   # capture git's ref lines (empty on a manual/TTY run)
pnpm agent-tools:secret-scan --remote "$1" --refs-file "$secret_scan_refs"
secret_scan_status=$?
rm -f "$secret_scan_refs"
if [ "$secret_scan_status" -ne 0 ]; then
  echo "❌ Secret scan failed."
  echo "Remove or scrub secret-like values before pushing."
  echo "Use local placeholders for .env.example and real credentials only in .env files."
  exit 1
fi

echo "📝 Checking formatting..."
if ! pnpm format-check:root; then
  echo "❌ Formatting issues found!"
  echo "💡 Run 'pnpm format:root' to fix formatting issues, then commit the changes"
  exit 1
fi

echo "🔍 Running full markdownlint..."
if ! pnpm markdownlint-check:root; then
  echo "❌ Markdownlint issues found!"
  echo "💡 Run 'pnpm markdownlint:root' to fix markdown issues, then commit again"
  exit 1
fi

echo "🔧 Validating sub-agents..."
if ! pnpm subagents:check; then
  echo "❌ Sub-agent validation failed!"
  exit 1
fi

echo "🔧 Validating portability..."
if ! pnpm portability:check; then
  echo "❌ Portability validation failed!"
  exit 1
fi

echo "🔧 Validating skill adapters..."
if ! pnpm skills:check; then
  echo "❌ Skill adapter validation failed — adapters have drifted from their canonical skills!"
  echo "💡 Run 'node agent-tools/dist/src/bin/skills-adapter-generate.js --prefix=oak-' to regenerate, then commit"
  exit 1
fi

echo "🧪 Running workspace-owned repo validators..."
if ! pnpm repo-validators:check; then
  echo "❌ Repo validator checks failed!"
  exit 1
fi

echo "🐚 Linting shell scripts..."
if ! pnpm lint:shell; then
  echo "❌ Shell script lint failed!"
  exit 1
fi

# Advisory only — warns when the committed OpenAPI schema cache is stale versus
# upstream. Never blocks the push (the check always exits 0; `|| true` is
# belt-and-braces so a network blip or future change cannot fail pre-push).
echo "🔭 Checking schema cache staleness (advisory, non-blocking)..."
pnpm --filter @oaknational/agent-tools ci-schema-drift-check || true

echo "🔤 Running build, type-check, lint, and tests..."
# Same env hygiene as pre-commit's turbo step (full rationale there): git
# exports repo-discovery env to hooks — GIT_DIR, and a GIT_INDEX_FILE that
# during real commits is a transient lock file — and a build tool's
# children must not inherit either. Unset the trio for the turbo child
# only (same load-bearing narrow scope); turbo re-derives the repo from
# cwd in every checkout shape. No gate is narrowed. Dated account: MCP-414.
if ! env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
  pnpm turbo run --continue sdk-codegen build type-check lint test test:e2e test:ui; then
  echo "❌ Turbo quality gate checks failed!"
  exit 1
fi

echo "🔗 Running depcruise (circular deps, orphans, layer violations)..."
# Runs AFTER the Turbo build for the same reason as knip below: depcruise
# resolves package exports through built dist outputs, so a fresh checkout
# would fail or cruise an incomplete graph before the build has run.
if ! pnpm depcruise; then
  echo "❌ Dependency-cruiser found violations!"
  echo "💡 Run 'pnpm depcruise' to see details, then fix circular dependencies or orphan modules"
  exit 1
fi

echo "🔬 Running knip (unused code detection)..."
# knip:gate (repo-check knip-gate) also fails when knip exits 0 after a
# swallowed config-load crash — a crashed analysis can never read as a pass (F-147).
# Runs AFTER the Turbo build: knip loads packages whose exports resolve to
# generated dist files, so a fresh checkout would fail closed here before
# the build has run (CI restores build outputs before knip for the same reason).
if ! pnpm knip:gate; then
  echo "❌ Knip found unused code, or the knip analysis itself crashed!"
  echo "💡 Run 'pnpm knip:gate' to see details, then fix or remove unused items"
  echo "   (a 'died without a verdict' line above is the crash class, not unused code — F-112 in the frictions register)"
  exit 1
fi

echo "🔤 Scanning file encoding (builds agent-tools, then runs the built scanner)..."
if ! pnpm encoding:check; then
  echo "❌ Encoding scan found a critical finding (invalid UTF-8, BOM, bidi/control byte, or U+FFFD)!"
  exit 1
fi

echo "✅ Pre-push checks completed!"
