{
  "name": "@oaknational/oak-design-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-page live showcase of the Oak Open Curriculum Design System: plain-CSS kit consumption with identity and theme switching.",
  "scripts": {
    "dev": "next dev -p 3020",
    "dev:open": "tsx tools/dev-open.ts",
    "build": "next build",
    "clean": "rm -rf .next .turbo",
    "start": "next start -p 3020",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "env -u NO_COLOR playwright test --grep-invert @a11y",
    "test:a11y": "env -u NO_COLOR playwright test --grep @a11y",
    "tool:fidelity": "tsx tools/fidelity-review.ts",
    "tool:visual-probe": "tsx tools/visual-probe.ts",
    "validate-authored-css": "tsx tools/validate-authored-css.ts",
    "validate-kit-assets": "tsx tools/validate-kit-assets.ts",
    "tool:capture-pair": "tsx tools/capture-pair.ts"
  },
  "dependencies": {
    "@oaknational/oak-design-react": "workspace:*",
    "@oaknational/oak-design-system": "workspace:*",
    "@oaknational/type-helpers": "workspace:*",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@oaknational/eslint-plugin-standards": "workspace:*",
    "@oaknational/fidelity-review": "workspace:*",
    "@oaknational/result": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.26",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-open-curriculum-ecosystem.git",
    "directory": "demos/oak-design-showcase"
  },
  "bugs": {
    "url": "https://github.com/oaknational/oak-open-curriculum-ecosystem/issues"
  },
  "homepage": "https://github.com/oaknational/oak-open-curriculum-ecosystem/tree/main/demos/oak-design-showcase#readme",
  "contributors": [
    {
      "name": "Oak National Academy",
      "email": "help@thenational.academy",
      "url": "https://www.thenational.academy"
    }
  ],
  "license": "MIT"
}
