  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@mcpjam/cli": "3.19.0",
    "@oaknational/eslint-plugin-standards": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "knip": "^6.32.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "~3.9.6",
    "semantic-release": "^25.0.9",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
