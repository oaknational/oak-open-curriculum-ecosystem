{
  "name": "@oaknational/open-curriculum-ecosystem",
  "version": "1.186.8",
  "private": true,
  "description": "Oak National Academy open curriculum data ecosystem - tools and services for working with the Oak Open Curriculum data",
  "author": "https://github.com/jimCresswell",
  "contributors": [
    {
      "name": "Jim Cresswell",
      "email": "contact@jimcresswell.net",
      "url": "https://jimcresswell.net"
    },
    {
      "name": "Mark Hodierne",
      "email": "mark@markhodierne.com"
    },
    {
      "name": "John Roberts",
      "email": "john.roberts@thenational.academy"
    },
    {
      "name": "Heather W"
    },
    {
      "name": "Oak National Academy",
      "email": "help@thenational.academy",
      "url": "https://www.thenational.academy"
    }
  ],
  "type": "module",
  "scripts": {
    "pnpm:devPreinstall": "node runtime-only-scripts/validate-package-manager-version.mjs",
    "sdk-codegen": "turbo run --continue sdk-codegen",
    "sdk-codegen:refresh": "SDK_CODEGEN_MODE=online turbo run --continue --force=true sdk-codegen && turbo run --continue build",
    "vocab-gen": "pnpm --filter @oaknational/sdk-codegen vocab-gen",
    "build": "turbo run --continue build",
    "clean": "turbo run --continue clean",
    "dev": "turbo run --continue dev",
    "design:showcase": "pnpm --filter @oaknational/oak-design-showcase dev:open",
    "test": "turbo run --continue test",
    "test:widget": "turbo run --continue test:widget",
    "docs-validators:check": "pnpm --filter @oaknational/agent-tools validate-reference-direction && pnpm --filter @oaknational/agent-tools validate-no-machine-local-paths && pnpm --filter @oaknational/agent-tools validate-no-lineage-names && pnpm --filter @oaknational/agent-tools validate-core-adr-citations && pnpm --filter @oaknational/agent-tools validate-no-host-names-in-core-headings && pnpm --filter @oaknational/agent-tools validate-markdown-links && pnpm --filter @oaknational/agent-tools validate-cited-scripts && pnpm --filter @oaknational/agent-tools validate-cited-paths && pnpm --filter @oaknational/agent-tools validate-patterns-index",
    "plan-gates:check": "pnpm --filter @oaknational/agent-tools check-plan-gate-drift",
    "repo-validators:check": "pnpm --filter @oaknational/agent-tools validate-check-ci-parity && pnpm --filter @oaknational/agent-tools validate-claim-freshness && pnpm --filter @oaknational/agent-tools validate-pretooluse-guard-routing && pnpm --filter @oaknational/agent-tools validate-policy-reappraisal && pnpm --filter @oaknational/agent-tools validate-lifecycle-scripts && pnpm --filter @oaknational/agent-tools validate-no-stale-script-invocations && pnpm --filter @oaknational/agent-tools validate-collaboration-state && pnpm --filter @oaknational/agent-tools validate-identity-naming && pnpm --filter @oaknational/agent-tools validate-workspace-config-isolation && pnpm --filter @oaknational/agent-tools validate-plan-corpus && pnpm --filter @oaknational/agent-tools validate-protocol-wire-contract && pnpm --filter @oaknational/agent-tools validate-family-conformance && pnpm practice:substrate:check && pnpm --filter @oaknational/eslint-plugin-standards validate-boundaries && pnpm --filter @oaknational/oak-design-tokens validate-design-system-consistency && pnpm --filter @oaknational/agent-tools validate-codex-team-alert-bootstrap && pnpm --filter @oaknational/agent-tools validate-notion-fence && pnpm --filter @oaknational/agent-tools validate-mcp-content-current-source && pnpm --filter @oaknational/agent-tools validate-mcp-content-workspace && pnpm --filter @oaknational/oak-curriculum-mcp-streamable-http validate-served-tool-table && pnpm --filter @oaknational/agent-tools validate-under-the-hood-content && pnpm --filter @oaknational/oak-design-showcase validate-authored-css && pnpm --filter @oaknational/oak-design-showcase validate-kit-assets",
    "test:field-integrity": "vitest run --config vitest.field-integrity.config.ts",
    "mutate": "turbo run --continue mutate",
    "test:e2e": "turbo run --continue test:e2e",
    "test:ui": "turbo run --continue test:ui",
    "test:a11y": "turbo run --continue test:a11y",
    "test:widget:ui": "turbo run --continue test:widget:ui",
    "test:widget:a11y": "turbo run --continue test:widget:a11y",
    "test:all": "turbo run --continue test test:widget test:e2e test:ui test:a11y test:widget:ui test:widget:a11y",
    "agent-tools:build": "pnpm --filter @oaknational/agent-tools build",
    "agent-tools:lint": "pnpm --filter @oaknational/agent-tools lint",
    "agent-tools:test": "pnpm --filter @oaknational/agent-tools test",
    "agent-tools:test:e2e": "pnpm --filter @oaknational/agent-tools test:e2e",
    "agent-tools": "pnpm --filter @oaknational/agent-tools agent-tools",
    "agent-tools:agent-identity": "pnpm --filter @oaknational/agent-tools agent-identity",
    "agent-tools:collaboration-state": "pnpm --filter @oaknational/agent-tools collaboration-state",
    "agent-tools:claude-agent-ops": "pnpm --filter @oaknational/agent-tools claude-agent-ops",
    "agent-tools:commit-queue": "pnpm --filter @oaknational/agent-tools commit-queue",
    "agent-tools:cursor-session-from-claude-session": "pnpm --filter @oaknational/agent-tools cursor-session-from-claude-session",
    "agent-tools:install-cursor-statusline": "node .cursor/scripts/install-statusline-cli-config.mjs",
    "agent-tools:codex-reviewer-resolve": "pnpm --filter @oaknational/agent-tools codex-reviewer-resolve",
    "codex-team-alert-bootstrap:generate": "pnpm --filter @oaknational/agent-tools codex-team-alert-bootstrap-generate",
    "agent-tools:branch-touched-files": "pnpm --filter @oaknational/agent-tools branch-touched-files",
    "agent-tools:codex-exec": "pnpm --filter @oaknational/agent-tools codex-exec",
    "agent-tools:pr-watch": "pnpm --filter @oaknational/agent-tools pr-watch",
    "agent-tools:repo-check": "pnpm --fail-if-no-match --filter @oaknational/agent-tools repo-check",
    "agent-tools:gate-slot": "pnpm --fail-if-no-match --filter @oaknational/agent-tools gate-slot",
    "agent-tools:pre-tool-use-dispatch": "pnpm --filter @oaknational/agent-tools pre-tool-use-dispatch",
    "agent-tools:check-encoding": "pnpm --filter @oaknational/agent-tools check-encoding",
    "agent-tools:check-commit-message": "pnpm --filter @oaknational/agent-tools check-commit-message",
    "agent-tools:workspace-census": "pnpm --filter @oaknational/agent-tools workspace-census",
    "agent-tools:secret-scan": "pnpm --filter @oaknational/agent-tools secret-scan",
    "agent-tools:review-cost": "pnpm --fail-if-no-match --filter @oaknational/agent-tools review-cost",
    "agent-tools:skill-evals": "pnpm --filter @oaknational/agent-tools skill-evals",
    "agent-tools:check-commit-skill-advisories": "pnpm --filter @oaknational/agent-tools check-commit-skill-advisories",
    "agent-tools:prevent-accidental-major-version": "pnpm --filter @oaknational/agent-tools prevent-accidental-major-version",
    "practice:substrate:check": "pnpm --filter @oaknational/agent-tools practice-substrate check",
    "protocol:conformance": "pnpm --filter @oaknational/agent-tools protocol-conformance",
    "mcp:conformance": "pnpm --silent --filter @oaknational/agent-tools mcp-conformance",
    "mcp:conformance:ci": "pnpm --filter @oaknational/agent-tools mcp-conformance:ci",
    "type-check": "turbo run --continue type-check",
    "format:root": "pnpm agent-tools:repo-check prettier-tracked --write",
    "format-check:root": "pnpm agent-tools:repo-check prettier-tracked",
    "markdownlint:root": "pnpm agent-tools:repo-check markdownlint-tracked --fix",
    "markdownlint-check:root": "pnpm agent-tools:repo-check markdownlint-tracked",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "knip:gate": "pnpm agent-tools:repo-check knip-gate",
    "depcruise": "pnpm agent-tools:repo-check depcruise-gate",
    "depcruise:report": "depcruise apps packages agent-tools demos --output-type dot > dependency-graph.dot",
    "lint": "turbo run --continue lint",
    "lint:fix": "turbo run --continue lint:fix",
    "lint:clean": "rm -rf **/.eslintcache",
    "lint:shell": "pnpm agent-tools:repo-check shellcheck-tracked",
    "lint:runtime-only": "eslint --max-warnings 0 --config eslint.runtime-only.config.mjs \"runtime-only-scripts/**/*.mjs\"",
    "subagents:check": "pnpm --filter @oaknational/agent-tools validate-subagents",
    "portability:check": "pnpm --filter @oaknational/agent-tools validate-portability",
    "profile:check": "pnpm --filter @oaknational/agent-tools validate-operator-profile",
    "profile:sync": "pnpm --filter @oaknational/agent-tools operator-profile-sync",
    "portability:fix": "pnpm --filter @oaknational/agent-tools validate-portability:fix",
    "skills:check": "pnpm agent-tools:build && node agent-tools/dist/src/bin/skills-adapter-generate.js --check --prefix=oak-",
    "skills:generate": "pnpm agent-tools:build && node agent-tools/dist/src/bin/skills-adapter-generate.js --prefix=oak-",
    "encoding:check": "pnpm agent-tools:build && node agent-tools/dist/src/encoding/check-encoding.js --fail-on critical",
    "practice:fitness": "pnpm --filter @oaknational/agent-tools validate-practice-fitness",
    "practice:fitness:informational": "pnpm --filter @oaknational/agent-tools validate-practice-fitness -- --informational",
    "practice:fitness:strict-hard": "pnpm --filter @oaknational/agent-tools validate-practice-fitness -- --strict-hard",
    "practice:vocabulary": "pnpm --filter @oaknational/agent-tools validate-fitness-vocabulary",
    "qa:oauth": "cd apps/oak-curriculum-mcp-streamable-http && LOG_LEVEL=debug node dist/index.js",
    "make": "pnpm i && turbo run build type-check lint:fix && pnpm subagents:check && pnpm portability:check && pnpm practice:fitness:informational && pnpm markdownlint:root && pnpm format:root",
    "re-build": "pnpm clean && pnpm install && turbo run build",
    "fix": "pnpm format:root && pnpm markdownlint:root && pnpm lint:fix",
    "check": "pnpm secrets:scan && pnpm format-check:root && pnpm markdownlint-check:root && pnpm lint:shell && pnpm lint:runtime-only && turbo run --continue sdk-codegen && turbo run --continue build type-check lint test test:e2e && turbo run --continue test:ui test:widget test:a11y test:widget:ui test:widget:a11y && pnpm knip:gate && pnpm depcruise && pnpm portability:check && pnpm subagents:check && pnpm skills:check && pnpm encoding:check && pnpm repo-validators:check && pnpm docs-validators:check",
    "check:docs": "pnpm format-check:root && pnpm markdownlint-check:root && pnpm docs-validators:check",
    "fix:docs": "pnpm format:root && pnpm markdownlint:root && pnpm docs-validators:check",
    "check:profile": "pnpm agent-tools:repo-check profile",
    "app:search": "pnpm run dev --filter=@oaknational/search-cli",
    "app:mcp": "pnpm run dev --filter=@oaknational/oak-curriculum-mcp-streamable-http",
    "prepare": "husky",
    "postinstall": "tsx agent-tools/src/bootstrap/bootstrap.ts",
    "publish:dry": "pnpm -r publish --dry-run",
    "publish:packages": "pnpm -r publish",
    "outdated": "pnpm outdated -r",
    "update:playwright": "pnpm install --save-dev -w @playwright/test@latest && pnpm exec playwright install --with-deps",
    "secrets:scan": "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.renameLimit GIT_CONFIG_VALUE_0=3000 gitleaks detect --redact=100 --source . --log-opts=\"--branches --tags\"",
    "secrets:scan:all": "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.renameLimit GIT_CONFIG_VALUE_0=3000 gitleaks detect --redact=100 --source . --log-opts=\"--branches --tags --full-history\"",
    "secrets:scan:all-refs": "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.renameLimit GIT_CONFIG_VALUE_0=3000 gitleaks detect --redact=100 --source . --log-opts=\"--all --full-history\"",
    "agent-tools:pr-throughput": "pnpm --filter @oaknational/agent-tools pr-throughput",
    "under-the-hood-content:generate": "pnpm exec tsx agent-tools/src/bin/under-the-hood-content-generate.ts",
    "agent-tools:context-cost": "pnpm --filter @oaknational/agent-tools context-cost"
  },
  "keywords": [
    "mcp",
    "curriculum",
    "oak",
    "sdk",
    "education",
    "ai",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-open-curriculum-ecosystem.git"
  },
  "bugs": {
