{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "remoteCache": {
    "enabled": true
  },
  "globalPassThroughEnv": [
    "OAK_API_KEY",
    "LOG_LEVEL",
    "OAK_API_URL",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "DANGEROUSLY_DISABLE_AUTH",
    "ELASTICSEARCH_URL",
    "ELASTICSEARCH_API_KEY",
    "SEARCH_INDEX_TARGET",
    "SEARCH_INDEX_VERSION",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_DSN",
    "SENTRY_MODE",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_REPO_SLUG",
    "SENTRY_TRACES_SAMPLE_RATE",
    "TEST_ERROR_SECRET",
    "VERCEL_GIT_REPO_OWNER",
    "VERCEL_GIT_REPO_SLUG"
  ],
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "tasks": {
    "sdk-codegen": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["**/generated/**", "**/schema-cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/code-generation/**/*.ts",
        "**/vocab-gen/**/*.ts",
        "**/scripts/**/*.ts",
        "**/schema-cache/**"
      ],
      "env": ["SDK_CODEGEN_MODE", "VERCEL", "VERCEL_GIT_COMMIT_SHA", "VERCEL_DEPLOYMENT_ID"],
      "passThroughEnv": ["OAK_API_KEY"]
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["dist/**", ".tsup/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsup.config.base.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsup.config.ts",
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts"
      ]
    },
    "@oaknational/sdk-codegen#build": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": true,
      "outputs": ["dist/**", ".tsup/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsup.config.base.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsup.config.ts",
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts"
      ]
    },
    "@oaknational/oak-curriculum-mcp-streamable-http#build": {
      "dependsOn": ["^build"],
      "cache": true,
      // The bake writes these values into .generated/landing-page.html, so
      // they must be hash-bearing (a cache hit across deployments would
      // otherwise replay another environment's baked host) AND visible under
      // strict envMode (APP_VERSION_OVERRIDE is in no default passthrough).
      // Same reasoning as sdk-codegen's env block above.
      "env": ["VERCEL_ENV", "VERCEL_URL", "VERCEL_PROJECT_PRODUCTION_URL", "APP_VERSION_OVERRIDE"],
      "outputs": [
        "dist/**",
        ".tsup/**",
        ".generated/**",
        "public/oak-ds/**",
        "public/oak-assets/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsup.config.base.ts",
        // The bake stamps the root package version into the page's
        // app-version meta (ROOT_PACKAGE_VERSION fallback), so a release
        // bump must invalidate this task or a cache hit replays the
        // previous release's version into the artefact.
        "$TURBO_ROOT$/package.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsup.config.ts",
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts",
        // The design system is copied into public/oak-ds at build time. It
        // has no build script, but its file changes still reach this task's
        // hash through ^build (probed 2026-07-31 on Turbo 2.10.6: a
        // scriptless workspace dependency's file change moved the
        // dependent's #build hash). These explicit inputs pin the
        // stale-bundle invalidation contract to the files themselves rather
        // than riding that implicit, version-dependent graph hashing.
        "$TURBO_ROOT$/packages/design/oak-design-system/**",
        "!$TURBO_ROOT$/packages/design/oak-design-system/studio-source/**",
        // Same contract for the brand artwork: copied at build time, no
        // build script of its own; the explicit leg keeps its invalidation
        // pinned too.
        "$TURBO_ROOT$/packages/design/oak-design-assets/**"
      ]
    },
    "@oaknational/oak-curriculum-mcp-streamable-http#test": {
      // Own `build` (which already implies ^build): suites that construct
      // the app read the copied design system under public/ at boot, and
      // src/server.ts's boot-read needs the baked landing-page artefact
      // under .generated/ — the build is both trees' sole writer, and a
      // cache hit restores them. The design-system hash legs live on
      // #build and fold into this task's hash through the dependency, so a
      // design-system-only edit re-runs these suites rather than replaying
      // a stale green verdict.
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "@oaknational/oak-curriculum-hub#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "@oaknational/oak-curriculum-hub#type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "@oaknational/oak-curriculum-hub#lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.next/**",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "@oaknational/oak-design-showcase#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "@oaknational/oak-design-showcase#type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "@oaknational/oak-design-showcase#lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.next/**",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "@oaknational/oak-design-tokens#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "tsconfig.json",
        "tsconfig.lint.json",
        "src/**/*.ts",
        "src/**/*.json"
      ]
    },
    "@oaknational/oak-design-tokens#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "src/**/*.json",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "@oaknational/oak-design-tokens#type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "tsconfig.json",
        "tsconfig.lint.json",
        "src/**/*.ts",
        "src/**/*.json"
      ]
    },
    "@oaknational/oak-design-tokens#lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "src/**/*.ts",
        "src/**/*.json"
      ]
    },
    "@oaknational/oak-design-tokens#lint:fix": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "src/**/*.ts",
        "src/**/*.json"
      ]
    },
    "@oaknational/sdk-codegen#test": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "@oaknational/sdk-codegen#type-check": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "@oaknational/sdk-codegen#lint": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "@oaknational/sdk-codegen#lint:fix": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["OAK_API_KEY"]
    },
    "dev:widget": {
      "cache": false,
      "persistent": true
    },
    "dev:widget-in-host": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "@oaknational/research-evidence#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.md",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.json",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.yaml",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.yml",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.js",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.cjs",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.mjs",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.ts",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.tsx",
        "!$TURBO_ROOT$/research/web-app-deconstruction/**/node_modules/**"
      ]
    },
    "mutate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts",
        "stryker.config.ts",
        "$TURBO_ROOT$/stryker.config.base.ts"
      ]
    },
    "test:widget": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "widget/**/*.ts",
        "widget/**/*.tsx",
        "vitest.widget.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "e2e-tests/**/*.ts",
        "vitest.e2e.config.ts",
        "$TURBO_ROOT$/vitest.e2e.config.base.ts",
        "$TURBO_ROOT$/test.setup.no-network.ts"
      ]
    },
    "@oaknational/agent-tools#test:e2e": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "e2e-tests/**/*.ts",
        "vitest.e2e.config.ts",
        "$TURBO_ROOT$/vitest.e2e.config.base.ts",
        "$TURBO_ROOT$/test.setup.no-network.ts",
        "$TURBO_ROOT$/.codex/hooks/practice-session-identity.mjs"
      ]
    },
    "test:ui": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "playwright.config.ts"]
    },
    "test:a11y": {
      "dependsOn": ["build", "test:ui"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "playwright.config.ts"]
    },
    "test:widget:ui": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "**/*.tsx", "playwright.widget.config.ts"]
    },
    "test:widget:a11y": {
      "dependsOn": ["build", "test:widget:ui"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "**/*.tsx", "playwright.widget.config.ts"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    }
  }
}
