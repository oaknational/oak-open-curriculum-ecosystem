{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "remoteCache": {
    "enabled": true
  },
  "globalPassThroughEnv": [
    "OAK_API_KEY",
    "LOG_LEVEL",
    "OAK_API_URL",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "DANGEROUSLY_DISABLE_AUTH",
    "ELASTICSEARCH_URL",
    "ELASTICSEARCH_API_KEY",
    "SEARCH_INDEX_TARGET",
    "SEARCH_INDEX_VERSION",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_DSN",
    "SENTRY_MODE",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_REPO_SLUG",
    "SENTRY_TRACES_SAMPLE_RATE",
    "TEST_ERROR_SECRET",
    "VERCEL_GIT_REPO_OWNER",
    "VERCEL_GIT_REPO_SLUG"
  ],
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "tasks": {
    "sdk-codegen": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["**/generated/**", "**/schema-cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/code-generation/**/*.ts",
        "**/vocab-gen/**/*.ts",
        "**/scripts/**/*.ts",
        "**/schema-cache/**"
      ],
      "env": ["SDK_CODEGEN_MODE"],
      "passThroughEnv": ["OAK_API_KEY"]
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["dist/**", ".tsup/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsup.config.base.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsup.config.ts",
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts"
      ]
    },
    "@oaknational/sdk-codegen#build": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": true,
      "outputs": ["dist/**", ".tsup/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsup.config.base.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsup.config.ts",
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts"
      ]
    },
    "@oaknational/oak-curriculum-mcp-streamable-http#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["dist/**", ".tsup/**", "public/oak-ds/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsup.config.base.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsup.config.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        // The .tsx twins matter as much as the .ts ones: $TURBO_DEFAULT$ pulls
        // in every tracked file, so without these negations a landing-page
        // component test invalidates the build cache and replays the bundle.
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.spec.tsx",
        // The design system is copied into public/oak-ds at build time. It has
        // no build script, so ^build contributes no hash leg for it — without
        // these inputs a design-system edit replays a stale bundle.
        "$TURBO_ROOT$/packages/design/oak-design-system/**",
        "!$TURBO_ROOT$/packages/design/oak-design-system/studio-source/**",
        // Same reasoning for the brand artwork: copied at build time, no build
        // script of its own, so nothing else contributes a hash leg for it.
        "$TURBO_ROOT$/packages/design/oak-design-assets/**"
      ]
    },
    "@oaknational/oak-curriculum-mcp-streamable-http#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts",
        // Same reason as #build above: the manifest and static-serving guards
        // assert against the design system's real contents, so a
        // design-system-only change must re-run them rather than replay a
        // stale green verdict.
        "$TURBO_ROOT$/packages/design/oak-design-system/**",
        "!$TURBO_ROOT$/packages/design/oak-design-system/studio-source/**",
        "$TURBO_ROOT$/packages/design/oak-design-assets/**"
      ]
    },
    "@oaknational/oak-curriculum-hub#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "@oaknational/oak-curriculum-hub#type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "@oaknational/oak-curriculum-hub#lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.next/**",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "@oaknational/oak-design-tokens#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "tsconfig.json",
        "tsconfig.lint.json",
        "src/**/*.ts",
        "src/**/*.json"
      ]
    },
    "@oaknational/oak-design-tokens#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "src/**/*.json",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "@oaknational/oak-design-tokens#type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "tsconfig.json",
        "tsconfig.lint.json",
        "src/**/*.ts",
        "src/**/*.json"
      ]
    },
    "@oaknational/oak-design-tokens#lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "src/**/*.ts",
        "src/**/*.json"
      ]
    },
    "@oaknational/oak-design-tokens#lint:fix": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "src/**/*.ts",
        "src/**/*.json"
      ]
    },
    "@oaknational/sdk-codegen#test": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "@oaknational/sdk-codegen#type-check": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "@oaknational/sdk-codegen#lint": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "@oaknational/sdk-codegen#lint:fix": {
      "dependsOn": ["^build", "sdk-codegen"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["OAK_API_KEY"]
    },
    "dev:widget": {
      "cache": false,
      "persistent": true
    },
    "dev:widget-in-host": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "eslint.config.ts",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "@oaknational/research-evidence#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.md",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.json",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.yaml",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.yml",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.js",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.cjs",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.mjs",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.ts",
        "$TURBO_ROOT$/research/web-app-deconstruction/**/*.tsx",
        "!$TURBO_ROOT$/research/web-app-deconstruction/**/node_modules/**"
      ]
    },
    "mutate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts",
        "stryker.config.ts",
        "$TURBO_ROOT$/stryker.config.base.ts"
      ]
    },
    "test:widget": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "widget/**/*.ts",
        "widget/**/*.tsx",
        "vitest.widget.config.ts",
        "$TURBO_ROOT$/vitest.config.base.ts"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "e2e-tests/**/*.ts", "vitest.e2e.config.ts"]
    },
    "test:ui": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "playwright.config.ts"]
    },
    "test:visual": {
      // Runs after test:a11y so the three browser suites serialise rather than
      // contending for the same dev-server ports. Baselines are an input: a
      // regenerated PNG must re-run the comparison, not replay a cached pass.
      "dependsOn": ["build", "test:a11y"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "playwright.config.ts", "tests/appearance/**"]
    },
    "test:a11y": {
      "dependsOn": ["build", "test:ui"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "playwright.config.ts"]
    },
    "test:widget:ui": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "**/*.tsx", "playwright.widget.config.ts"]
    },
    "test:widget:a11y": {
      "dependsOn": ["build", "test:widget:ui"],
      "outputs": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "**/*.tsx", "playwright.widget.config.ts"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.lint.json",
        "**/*.ts"
      ]
    }
  }
}
