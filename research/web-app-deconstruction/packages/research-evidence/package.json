{
  "name": "@oaknational/research-evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "inventory": "tsx ./scripts/component-boundary-inventory.ts",
    "inventory:owa-architecture": "tsx ./scripts/owa-architecture-inventory.ts",
    "inventory:oce": "tsx ./scripts/oce-inventory.ts",
    "inventory:database-api-chain": "tsx ./scripts/database-api-chain-inventory.ts",
    "compare:openapi-oce": "tsx ./scripts/openapi-oce-contract-comparison.ts",
    "validate:concept-links": "tsx ./scripts/validate-concept-lens-links.ts --docs ../../docs/current-state/owa-components-concept-lenses && tsx ./scripts/validate-concept-lens-links.ts --docs ../../docs/current-state/database-tools",
    "check-research": "tsx ./scripts/check-research.ts",
    "runtime:artifact": "tsx ./scripts/oak-components-runtime.ts --skip-next",
    "runtime:next": "tsx ./scripts/oak-components-runtime.ts --only-next",
    "runtime": "tsx ./scripts/oak-components-runtime.ts",
    "curriculum-redirect": "tsx ./scripts/curriculum-export-redirect.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run && tsx ./scripts/check-research.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@oaknational/eslint-plugin-standards": "workspace:*",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
